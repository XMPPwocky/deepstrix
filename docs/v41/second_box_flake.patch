diff -ruN '--exclude=.git' '--exclude=result*' pristine/lumi-brain/modules/installer-common.nix lumi-brain/modules/installer-common.nix
--- pristine/lumi-brain/modules/installer-common.nix	1970-01-01 00:00:00.000000000 +0000
+++ lumi-brain/modules/installer-common.nix	2026-09-12 22:27:54.216124979 +0000
@@ -0,0 +1,51 @@
+# Content shared by the two installer images (modules/installer.nix = bootable
+# ISO, modules/installer-netboot.nix = PXE kernel+initrd): latest kernel and
+# firmware, networkd + iwd with DHCP on every wired/wireless interface, root
+# auto-login on tty1, sshd with root key-only login for Claude's and Mimir's
+# keys, tailscale, bolt and the usual tools. Nothing network-specific and no
+# credentials are baked in; Wi-Fi is joined from the console with iwctl (see
+# README). Which media-specific profile is imported (installation-cd-minimal
+# vs netboot-minimal) is the only difference between the two images.
+{ config, lib, pkgs, ... }:
+{
+  # Strix Halo + MT7925 Wi-Fi 7 need the freshest kernel/firmware.
+  boot.kernelPackages = pkgs.linuxPackages_latest;
+  hardware.enableRedistributableFirmware = true;
+  networking.hostName = "lumi-installer";
+
+  # networkd + iwd, the same shape as modules/networking.nix.
+  # The stock installer enables NetworkManager (which pulls wpa_supplicant);
+  # we want networkd + iwd, so force those off.
+  networking.networkmanager.enable = lib.mkForce false;
+  networking.useNetworkd = lib.mkForce true;
+  networking.useDHCP = lib.mkForce false;
+  networking.wireless.enable = lib.mkForce false; # no wpa_supplicant
+  networking.wireless.iwd = {
+    enable = true;
+    settings.General.EnableNetworkConfiguration = false;
+  };
+  systemd.network.enable = true;
+  systemd.network.networks."10-any" = {
+    matchConfig.Name = "en* eth* wl*";
+    networkConfig.DHCP = "yes";
+    dhcpV4Config.UseDNS = true;
+  };
+
+  # Passwordless root shell on the attached console: auto-login on tty1.
+  services.getty.autologinUser = lib.mkForce "root";
+  users.users.root.initialHashedPassword = lib.mkForce "";
+
+  services.openssh = {
+    enable = true;
+    settings.PermitRootLogin = "prohibit-password";
+    settings.PasswordAuthentication = false;
+  };
+  users.users.root.openssh.authorizedKeys.keys = [
+    "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJ+XQ2XiSAw1hRNMby3BFPaXk4hT/phV3WV27VWQKJ1J claude-code@pocket-shoggoth"
+    "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIIW/u+eaeLemwoh2wdtDyQ3+xANnBtQRMysHS1XKH38Y mimir@mimir-nixos-fw"
+  ];
+  services.tailscale.enable = true; # optional: `tailscale up` from the console if Wi-Fi fails
+  services.hardware.bolt.enable = true;
+  environment.systemPackages = with pkgs; [ git rsync iperf3 bolt pciutils usbutils nvme-cli ];
+  system.stateVersion = "25.11";
+}
diff -ruN '--exclude=.git' '--exclude=result*' pristine/lumi-brain/modules/installer-netboot.nix lumi-brain/modules/installer-netboot.nix
--- pristine/lumi-brain/modules/installer-netboot.nix	1970-01-01 00:00:00.000000000 +0000
+++ lumi-brain/modules/installer-netboot.nix	2026-09-12 22:27:54.219124894 +0000
@@ -0,0 +1,29 @@
+# PXE / netboot variant of the installer: the same content as the ISO
+# (modules/installer-common.nix) but built as a kernel + initrd (the initrd
+# carries the squashfs Nix store) plus an iPXE script, instead of an ISO.
+# modules/pxe-installer.nix serves the three files to a box connected by a
+# direct Ethernet cable; see docs/v41/SECOND_BOX.md "PXE netboot bring-up".
+#
+#   nix build .#netboot-dir   →  result/{bzImage,initrd,netboot.ipxe}
+#
+# nixpkgs' netboot.nix provides system.build.{kernel,netbootRamdisk,
+# netbootIpxeScript}; the flake's `netboot-dir` package links them into one
+# directory whose layout matches the relative URLs in netboot.ipxe
+# (`kernel bzImage ...` / `initrd initrd`).
+{ config, lib, pkgs, modulesPath, ... }:
+{
+  imports = [
+    "${modulesPath}/installer/netboot/netboot-minimal.nix"
+    ./installer-common.nix
+  ];
+
+  # netboot-minimal.nix turns redistributable firmware off at priority 70
+  # (mkOverride 70 false), which beats the plain `= true` in installer-common.
+  # The netboot installer must be the same installer as the ISO — MT7925 Wi-Fi
+  # and the RTL8125 want their firmware — so win at a lower number.
+  hardware.enableRedistributableFirmware = lib.mkOverride 60 true;
+
+  # Same compression as the ISO (level 19 default takes far longer for a
+  # negligible size win; this initrd crosses a 2.5 GbE cable in seconds).
+  netboot.squashfsCompression = "zstd -Xcompression-level 6";
+}
diff -ruN '--exclude=.git' '--exclude=result*' pristine/lumi-brain/modules/installer.nix lumi-brain/modules/installer.nix
--- pristine/lumi-brain/modules/installer.nix	1970-01-01 00:00:00.000000000 +0000
+++ lumi-brain/modules/installer.nix	2026-09-12 22:27:54.217124951 +0000
@@ -0,0 +1,20 @@
+# Bootable NixOS installer image (ISO) for bringing up a new box unattended:
+# boots, joins Wi-Fi (or DHCP on Ethernet), starts sshd with root key-only
+# login for Claude's and Mimir's keys, so the installation can be driven over
+# the network from lumi-brain with `nix run .#install lumi-brain2 root@<ip>`.
+#
+#   nix build .#installer-iso     →  result/iso/*.iso   →  dd to a USB stick
+#
+# The installer content itself lives in modules/installer-common.nix and is
+# shared with the PXE variant (modules/installer-netboot.nix); this file only
+# picks the ISO media profile. No credentials are baked in: join Wi-Fi from
+# the console with iwctl (see README).
+{ config, lib, pkgs, modulesPath, ... }:
+{
+  imports = [
+    "${modulesPath}/installer/cd-dvd/installation-cd-minimal.nix"
+    ./installer-common.nix
+  ];
+
+  isoImage.squashfsCompression = "zstd -Xcompression-level 6";
+}
diff -ruN '--exclude=.git' '--exclude=result*' pristine/lumi-brain/modules/interconnect.nix lumi-brain/modules/interconnect.nix
--- pristine/lumi-brain/modules/interconnect.nix	1970-01-01 00:00:00.000000000 +0000
+++ lumi-brain/modules/interconnect.nix	2026-09-13 02:50:06.319432081 +0000
@@ -0,0 +1,46 @@
+# USB4 host-to-host link between the two boxes (docs/v41/SECOND_BOX.md):
+# thunderbolt-net gives a thunderbolt0 interface once both sides authorised
+# each other with boltctl. Static /30, no DHCP, trusted by the firewall.
+{ config, lib, pkgs, ... }:
+let
+  cfg = config.lumi.interconnect;
+in
+{
+  options.lumi.interconnect = {
+    address = lib.mkOption {
+      type = lib.types.str;
+      description = "This box's address on the point-to-point link (10.99.0.1 or 10.99.0.2).";
+    };
+    mtu = lib.mkOption {
+      type = lib.types.int;
+      default = 65520; # thunderbolt-net maximum; measure against 1500 on day one
+    };
+  };
+
+  config = {
+    boot.kernelModules = [ "thunderbolt" "thunderbolt-net" ];
+    # MUST sort before modules/networking.nix's "10-wan" (Match Name=en* eth*):
+  # thunderbolt-net interfaces carry an `enx<mac>` alternative name, so the
+  # first-match rule would otherwise hand thunderbolt0 to the DHCP unit
+  # (observed on lumi-brain 2026-09-12: "10-wan.network, degraded (configuring)").
+  systemd.network.networks."05-interconnect" = {
+      matchConfig.Name = "thunderbolt0";
+      networkConfig = {
+        DHCP = "no";
+        Address = "${cfg.address}/30";
+      };
+      linkConfig.MTUBytes = toString cfg.mtu;
+    };
+    networking.firewall.trustedInterfaces = [ "thunderbolt0" ];
+  # NAPI busy polling: blocking reads / poll() spin in the driver's poll routine for
+  # up to this many µs before sleeping, taking the receive interrupt out of the
+  # thunderbolt-net round trip. Measured 2026-09-13 (docs/v41/SECOND_BOX.md §6):
+  # 4 KB request/reply p50 130 → 34 µs, 20 KB 340 → 86 µs. Global, so every
+  # socket pays a little CPU while waiting; the boxes are dedicated inference hosts.
+  boot.kernel.sysctl = {
+    "net.core.busy_poll" = 500;
+    "net.core.busy_read" = 500;
+  };
+    environment.systemPackages = with pkgs; [ iperf3 bolt ];
+  };
+}
diff -ruN '--exclude=.git' '--exclude=result*' pristine/lumi-brain/modules/pxe-installer.nix lumi-brain/modules/pxe-installer.nix
--- pristine/lumi-brain/modules/pxe-installer.nix	1970-01-01 00:00:00.000000000 +0000
+++ lumi-brain/modules/pxe-installer.nix	2026-09-12 22:33:47.705027414 +0000
@@ -0,0 +1,139 @@
+# PXE/netboot server for bringing up the second box over a direct Ethernet
+# cable, hands-off (docs/v41/SECOND_BOX.md "PXE netboot bring-up").
+#
+# Sequence on the cable:
+#   box 2 UEFI PXE  --DHCP-->  dnsmasq (this module)  : lease + "boot ipxe.efi"
+#   box 2 UEFI PXE  --TFTP-->  dnsmasq                : ipxe.efi (pkgs.ipxe)
+#   iPXE            --DHCP-->  dnsmasq                : marks itself (option 175)
+#                                                       → "boot http://10.43.0.1:8080/netboot.ipxe"
+#   iPXE            --HTTP-->  static-web-server      : netboot.ipxe, bzImage, initrd
+#   installer boots (modules/installer-netboot.nix): sshd with our keys on the
+#   lease address, then `nix run .#install lumi-brain2 root@10.43.0.<lease>`.
+#
+# Everything is scoped to ONE interface (default eno1, the otherwise unused
+# 2.5 GbE port): a static address from a networkd unit that sorts before
+# "10-wan" (the en* DHCP unit in modules/networking.nix), dnsmasq listening on
+# that interface only with DNS disabled, HTTP bound to that address only, and
+# firewall holes only on that interface. The Wi-Fi uplink, microvm-br (which
+# has its own networkd DHCP server) and tailscale0 are untouched, and nothing
+# here changes kernel parameters. Temporary: disable once box 2 is installed.
+{ config, lib, pkgs, inputs, ... }:
+let
+  cfg = config.lumi.pxeInstaller;
+  address = "10.43.0.1"; # 10.42/24 = microvm-br, 10.99.0/30 = USB4 interconnect
+  prefixLength = 24;
+  httpPort = 8080;
+  # Files the firmware's PXE client may ask for over TFTP.
+  tftpRoot = pkgs.linkFarm "pxe-tftp-root" [
+    { name = "ipxe.efi"; path = "${pkgs.ipxe}/ipxe.efi"; }
+    { name = "snp.efi"; path = "${pkgs.ipxe}/snp.efi"; }
+  ];
+in
+{
+  options.lumi.pxeInstaller = {
+    enable = lib.mkEnableOption "PXE/netboot server for the installer on a direct cable";
+
+    interface = lib.mkOption {
+      type = lib.types.str;
+      default = "eno1";
+      description = "Wired interface the second box is cabled to. Gets ${address}/${toString prefixLength}; nothing else is served on it.";
+    };
+
+    netbootDir = lib.mkOption {
+      type = lib.types.path;
+      default = inputs.self.packages.${pkgs.stdenv.hostPlatform.system}.netboot-dir;
+      defaultText = lib.literalExpression "inputs.self.packages.<system>.netboot-dir";
+      description = "Directory with netboot.ipxe, bzImage and initrd (flake package `netboot-dir`), served over HTTP.";
+    };
+
+    ipxeBinary = lib.mkOption {
+      type = lib.types.enum [ "ipxe.efi" "snp.efi" ];
+      default = "ipxe.efi";
+      description = ''
+        iPXE UEFI binary handed to the firmware's PXE client over TFTP.
+        ipxe.efi drives the NIC with iPXE's own drivers (falls back to the
+        firmware's SNP driver for NICs it has none for); snp.efi only ever
+        uses the firmware's driver — switch to it if ipxe.efi stalls at
+        "Configuring (net0 ...)" on box 2.
+      '';
+    };
+  };
+
+  config = lib.mkIf cfg.enable {
+    # (a) Static address. networkd applies the first .network file (in
+    # lexical order) whose [Match] fits, so "05-pxe-*" wins over "10-wan"
+    # (en* eth*, DHCP) for exactly this interface; other en* keep DHCP.
+    systemd.network.networks."05-pxe-${cfg.interface}" = {
+      matchConfig.Name = cfg.interface;
+      networkConfig = {
+        DHCP = "no";
+        Address = "${address}/${toString prefixLength}";
+        # Keep the address while the cable is unplugged (the common state),
+        # so dnsmasq and the HTTP socket can bind at boot and the link never
+        # gates network-online.target.
+        ConfigureWithoutCarrier = true;
+        LinkLocalAddressing = "no";
+        IPv6AcceptRA = false;
+        LLMNR = false;
+        MulticastDNS = false;
+      };
+      linkConfig.RequiredForOnline = "no";
+    };
+
+    # (b) DHCP + TFTP on that interface only. DNS is off (port=0), and
+    # resolveLocalQueries=false keeps the module from pointing this box's own
+    # resolv.conf at dnsmasq.
+    services.dnsmasq = {
+      enable = true;
+      resolveLocalQueries = false;
+      settings = {
+        port = 0; # no DNS at all: DHCP + TFTP only
+        interface = cfg.interface;
+        except-interface = "lo"; # `interface=` implicitly adds lo; we want exactly one
+        # Bind the interface's own addresses (not the wildcard), and re-bind
+        # as addresses appear: bind-interfaces would silently miss the TFTP
+        # listener if dnsmasq started before networkd assigned the address.
+        bind-dynamic = true;
+        dhcp-range = "10.43.0.10,10.43.0.100,12h";
+        dhcp-authoritative = true; # sole server on a point-to-point cable: NAK stale leases fast
+        # Key leases by MAC, not client-id: the firmware PXE client, iPXE, the
+        # installer's networkd and the installed system's networkd all present
+        # different client-ids, and box 2 should keep ONE address through all
+        # four phases.
+        dhcp-ignore-clid = true;
+        # No router / no DNS server option (dnsmasq would otherwise advertise
+        # itself): this box does not forward for the cable, and the installed
+        # lumi-brain2 must keep its Wi-Fi default route when it later leases
+        # from here again.
+        dhcp-option = [ "option:router" "option:dns-server" ];
+        enable-tftp = true;
+        tftp-root = "${tftpRoot}";
+        # The firmware's PXE client gets the iPXE binary by TFTP; iPXE tags its
+        # own DHCP requests with option 175 and is handed the HTTP script.
+        dhcp-match = "set:ipxe,175";
+        dhcp-boot = [
+          "tag:!ipxe,${cfg.ipxeBinary}"
+          "tag:ipxe,http://${address}:${toString httpPort}/netboot.ipxe"
+        ];
+        log-dhcp = true; # every DISCOVER/OFFER/ACK in `journalctl -u dnsmasq`
+      };
+    };
+
+    # (c) HTTP for netboot.ipxe + bzImage + initrd, bound to the link address
+    # only. static-web-server is socket-activated; FreeBind lets the socket
+    # bind even if the address is not assigned yet at that moment.
+    services.static-web-server = {
+      enable = true;
+      listen = "${address}:${toString httpPort}";
+      root = cfg.netbootDir;
+      configuration.general.log-level = "info"; # log each fetch: `journalctl -u static-web-server`
+    };
+    systemd.sockets.static-web-server.socketConfig.FreeBind = true;
+
+    # (d) Firewall: only on this interface, only what the sequence needs.
+    networking.firewall.interfaces.${cfg.interface} = {
+      allowedUDPPorts = [ 67 69 ]; # DHCP server, TFTP (data flows are conntrack-ESTABLISHED)
+      allowedTCPPorts = [ httpPort ];
+    };
+  };
+}
