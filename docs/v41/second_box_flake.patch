diff -ruN '--exclude=.git' '--exclude=result*' pristine/lumi-brain/hosts/lumi-brain2/disko.nix lumi-brain/hosts/lumi-brain2/disko.nix
--- pristine/lumi-brain/hosts/lumi-brain2/disko.nix	1970-01-01 00:00:00.000000000 +0000
+++ lumi-brain/hosts/lumi-brain2/disko.nix	2026-09-12 22:53:00.339303681 +0000
@@ -0,0 +1,69 @@
+# lumi-brain2 disk layout: the same LUKS root (btrfs /nix + /persist, tmpfs /)
+# plus a PLAINTEXT ext4 partition for model weights. Rationale: dm-crypt's
+# read workqueue was the cold-expert read bottleneck on lumi-brain
+# (docs/v41/COLD_EXPERT_CACHING.md); weights are public data, and ext4 avoids
+# btrfs COW/fragmentation on 400+ GB files.
+#
+# IMPORTANT: confirm the device path and the split on the live installer; the
+# sizes below assume a 2 TB drive (LUKS 600G, weights = rest ≈ 1.4 TB).
+{ ... }:
+{
+  disko.devices = {
+    disk.main = {
+      type = "disk";
+      device = "/dev/nvme0n1";
+      content = {
+        type = "gpt";
+        partitions = {
+          ESP = {
+            size = "1G";
+            type = "EF00";
+            content = {
+              type = "filesystem";
+              format = "vfat";
+              mountpoint = "/boot";
+              mountOptions = [ "umask=0077" ];
+            };
+          };
+          luks = {
+            size = "600G";
+            content = {
+              type = "luks";
+              name = "cryptroot";
+              settings.allowDiscards = true;
+              # No passwordFile: `cryptsetup luksFormat` prompts for the passphrase
+              # during `nix run .#install` (run it from a terminal) and at every boot.
+              content = {
+                type = "btrfs";
+                extraArgs = [ "-L" "lumi-brain2" "-f" ];
+                subvolumes = {
+                  "/@nix" = {
+                    mountpoint = "/nix";
+                    mountOptions = [ "compress=zstd" "noatime" ];
+                  };
+                  "/@persist" = {
+                    mountpoint = "/persist";
+                    mountOptions = [ "compress=zstd" "noatime" ];
+                  };
+                };
+              };
+            };
+          };
+          weights = {
+            size = "100%";
+            content = {
+              type = "filesystem";
+              format = "ext4";
+              mountpoint = "/weights";
+              mountOptions = [ "noatime" ];
+            };
+          };
+        };
+      };
+    };
+    nodev."/" = {
+      fsType = "tmpfs";
+      mountOptions = [ "defaults" "size=8G" "mode=755" ];
+    };
+  };
+}
