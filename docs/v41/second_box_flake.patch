diff -ruN '--exclude=.git' '--exclude=result*' pristine/lumi-brain/hosts/lumi-brain2/default.nix lumi-brain/hosts/lumi-brain2/default.nix
--- pristine/lumi-brain/hosts/lumi-brain2/default.nix	1970-01-01 00:00:00.000000000 +0000
+++ lumi-brain/hosts/lumi-brain2/default.nix	2026-09-12 23:01:03.156501397 +0000
@@ -0,0 +1,27 @@
+# lumi-brain2 — the 128 GB Strix Halo box: expert server / second iGPU for
+# DeepSeek-V4.1 (docs/v41/PLAN.md §4). Same platform, users, ssh, secrets and
+# impermanence as lumi-brain; no forgejo, no microvm host.
+{ ... }:
+{
+  imports = [
+    ./hardware.nix
+    ./disko.nix
+    ../../modules/base.nix
+    ../../modules/impermanence.nix
+    ../../modules/networking.nix
+    ../../modules/interconnect.nix
+    ../../modules/users.nix
+    ../../modules/ssh.nix
+    ../../modules/agenix.nix
+  ];
+
+  networking.hostName = "lumi-brain2";
+  # Claude's own key (generated on lumi-brain for the installer image) so the
+  # engine work on this box can be driven over the cable / USB4 link without
+  # a person in the loop; box 1 keeps its stricter key policy (modules/users.nix).
+  users.users.claude-code.openssh.authorizedKeys.keys = [
+    "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJ+XQ2XiSAw1hRNMby3BFPaXk4hT/phV3WV27VWQKJ1J claude-code@pocket-shoggoth"
+  ];
+  system.stateVersion = "25.11";
+  lumi.interconnect.address = "10.99.0.2";
