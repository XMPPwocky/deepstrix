+++ lumi-brain/modules/strix-halo.nix	2026-09-12 20:25:30.880224136 +0000
@@ -0,0 +1,51 @@
+# Strix Halo (Ryzen AI Max+ 395) platform bits shared by both boxes. The two
+# memory knobs scale with the box's RAM; box 1 (96 GB) keeps the values it
+# has run with, box 2 (128 GB) overrides them in its host module.
+{ config, lib, pkgs, ... }:
+let
+  cfg = config.lumi.strix;
+in
+{
+  options.lumi.strix = {
+    gttSizeMiB = lib.mkOption {
+      type = lib.types.int;
+      default = 98304; # 96 GiB: let the iGPU map (almost) all of RAM
+      description = "amdgpu.gttsize — GTT size in MiB, sized to the box's RAM.";
+    };
+    ttmPages = lib.mkOption {
+      type = lib.types.int;
+      default = 35165824; # box 1: raised above 96 GiB/4 KiB while the eGPU shares the pool
+      description = "ttm.page_pool_size and ttm.pages_limit, in 4 KiB pages.";
+    };
+  };
+
+  config = {
+    boot.kernelPackages = pkgs.linuxPackages_latest;
+    hardware.cpu.amd.updateMicrocode = true;
+    hardware.enableRedistributableFirmware = true;
+    hardware.graphics = {
+      enable = true;
+      enable32Bit = false;
+    };
+    boot.loader.systemd-boot.enable = true;
+    boot.loader.efi.canTouchEfiVariables = true;
+    boot.initrd.systemd.enable = true;
+    boot.initrd.availableKernelModules = [ "nvme" "xhci_pci" "ahci" "usb_storage" "usbhid" "sd_mod" "tpm_crb" "tpm_tis" ];
+    boot.initrd.kernelModules = [ ];
+    boot.kernelModules = [ "kvm-amd" ];
+    boot.extraModulePackages = [ ];
+    boot.kernelParams = [
+      "amdgpu.gttsize=${toString cfg.gttSizeMiB}"
+      "amdgpu.no_system_mem_limit=Y"
+      "ttm.page_pool_size=${toString cfg.ttmPages}"
+      "ttm.pages_limit=${toString cfg.ttmPages}"
+      "transparent_hugepage=always"
+    ];
+    boot.kernel.sysctl = {
+      "vm.compaction_proactiveness" = 20;
+    };
+    services.hardware.bolt.enable = true;
+    programs.nix-ld.enable = true;
+    nixpkgs.hostPlatform = "x86_64-linux";
+  };
+}
