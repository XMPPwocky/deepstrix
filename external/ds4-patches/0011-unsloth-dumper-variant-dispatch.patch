+/* deepstrix patch (Track R): per-tensor-type dispatch for the routed MoE
+ * dot kernels. The workers below used to hard-code IQ2_XXS (gate/up pair)
+ * and Q2_K (down); each caller now resolves the row dot once from the
+ * tensor's GGUF type and threads it through the worker ctx. For the
+ * original antirez mix the resolved functions are exactly the ones that
+ * were called directly before — identical math, one indirect call. */
+typedef void (*ds4_expert_dot_fn)(int n, float *s, const void *x, const block_q8_K *y);
+typedef void (*ds4_expert_pair_dot_fn)(int n, float *s0, float *s1,
+                                       const void *x0, const void *x1,
+                                       const block_q8_K *y);
+
+static void expert_dot_q2_K(int n, float *s, const void *x, const block_q8_K *y) {
+    ds4_vec_dot_q2_K_q8_K(n, s, (const block_q2_K *)x, y);
+}
+static void expert_dot_iq3_xxs(int n, float *s, const void *x, const block_q8_K *y) {
+    ds4_vec_dot_iq3_xxs_q8_K(n, s, (const block_iq3_xxs *)x, y);
+}
+static void expert_dot_mxfp4(int n, float *s, const void *x, const block_q8_K *y) {
+    ds4_vec_dot_mxfp4_q8_K(n, s, (const block_mxfp4 *)x, y);
+}
+static void expert_pair_dot_iq2_xxs(int n, float *s0, float *s1,
+                                    const void *x0, const void *x1,
+                                    const block_q8_K *y) {
+    ds4_vec_dot_iq2_xxs_pair_q8_K(n, s0, s1,
+                                  (const block_iq2_xxs *)x0,
+                                  (const block_iq2_xxs *)x1, y);
+}
+static void expert_pair_dot_iq2_s(int n, float *s0, float *s1,
+                                  const void *x0, const void *x1,
+                                  const block_q8_K *y) {
+    ds4_vec_dot_iq2_s_q8_K(n, s0, (const block_iq2_s *)x0, y);
+    ds4_vec_dot_iq2_s_q8_K(n, s1, (const block_iq2_s *)x1, y);
+}
+
+/* Down-projection (single-tensor) dot for a routed expert type, or NULL. */
+static ds4_expert_dot_fn expert_down_dot_for_type(uint32_t type) {
+    switch (type) {
+    case 10: return expert_dot_q2_K;
+    case 18: return expert_dot_iq3_xxs;
+    case 39: return expert_dot_mxfp4;
+    default: return NULL;
+    }
+}
+
+/* Gate/up (same-type pair) dot for a routed expert type, or NULL. */
+static ds4_expert_pair_dot_fn expert_pair_dot_for_type(uint32_t type) {
+    switch (type) {
+    case 16: return expert_pair_dot_iq2_xxs;
+    case 22: return expert_pair_dot_iq2_s;
+    default: return NULL;
+    }
+}
