+/* deepstrix patch (Track R): batched dense matmuls over F32 weights (the
+ * dumper variant's pre-dequantized attn_q_a / shexp / output). Token loop
+ * over the row-parallel matvec — throughput is irrelevant on this path. */
+static void matmul_f32_batch(
+        float           * out,
+        const ds4_model * m,
+        const ds4_tensor * w,
+        const float     * x,
+        uint64_t          n_tok) {
+    const uint64_t in_dim = w->dim[0];
+    const uint64_t out_dim = w->dim[1];
+    for (uint64_t t = 0; t < n_tok; t++) {
+        matvec_f32(out + t * out_dim, m, w, x + t * in_dim);
+    }
+}
+
+static void matmul_any_batch(
+        float           * out,
+        const ds4_model * m,
+        const ds4_tensor * w,
+        const float     * x,
+        uint64_t          n_tok) {
+    switch (w->type) {
+    case 0: matmul_f32_batch(out, m, w, x, n_tok); break;
+    case 8: matmul_q8_0_batch(out, m, w, x, n_tok); break;
+    default:
+        ds4_die("unsupported tensor type for batched dense matmul");
+    }
+}
