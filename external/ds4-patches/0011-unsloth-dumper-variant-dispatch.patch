+/* deepstrix patch (Track R): the "dumper variant" GGUF pre-dequantizes
+ * some dense Q8_0 tensors (attn_q_a, shexp, output head) to exact F32.
+ * Accept either; the matvec paths dispatch on the actual type. */
+static void tensor_expect_q8_0_or_f32_layout(
+        const ds4_tensor *t,
+        uint32_t          ndim,
+        uint64_t          d0,
+        uint64_t          d1,
+        uint64_t          d2) {
+    if (!t) ds4_die("internal error: missing tensor while validating layout");
+    if (t->type != DS4_TENSOR_Q8_0 && t->type != DS4_TENSOR_F32) {
+        fprintf(stderr,
+                "ds4: tensor %.*s has type %s, expected Q8_0 or F32\n",
+                (int)t->name.len,
+                t->name.ptr,
+                tensor_type_name(t->type));
+        exit(1);
+    }
+    tensor_expect_layout(t, t->type, ndim, d0, d1, d2);
+}
