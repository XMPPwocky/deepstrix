 static float rope_yarn_ramp(float low, float high, int i0) {
@@ -7544,9 +7568,40 @@
                                                   scratch);
     if (profile) t_kv = now_sec() - t0;
 
+    /* deepstrix dump: per-layer RoPE parameters (deduped at pos==0).
+     * 6 floats: [freq_base, freq_scale, ext_factor, attn_factor, beta_fast, beta_slow].
+     * beta_fast/beta_slow are hardcoded to DeepSeek-V4 defaults (32, 1) since
+     * ds4 does not parameterise them; M4 RoPE port treats them as a side-channel. */
+    if (pos == 0) {
+        const bool _ds4_dump_compressed = ds4_layer_compress_ratio(il) != 0;
+        const float _ds4_dump_freq_base = layer_rope_freq_base(il);
+        const float _ds4_dump_freq_scale = layer_rope_freq_scale(il);
+        const float _ds4_dump_ext_factor =
+            _ds4_dump_compressed && DS4_ROPE_SCALE_FACTOR > 1.0f ? 1.0f : 0.0f;
+        float _ds4_dump_attn_factor = 1.0f;
+        if (_ds4_dump_ext_factor != 0.0f && _ds4_dump_freq_scale > 0.0f) {
+            _ds4_dump_attn_factor /=
+                1.0f + 0.1f * logf(1.0f / _ds4_dump_freq_scale);
+        }
+        const float _ds4_dump_rope_params[6] = {
+            _ds4_dump_freq_base,
+            _ds4_dump_freq_scale,
+            _ds4_dump_ext_factor,
+            _ds4_dump_attn_factor,
+            32.0f,  /* beta_fast */
+            1.0f,   /* beta_slow */
+        };
+        ds4_dump_emit_1d("weight:rope_params", _ds4_dump_rope_params,
+                         DS4_DUMP_DTYPE_F32, 6);
+    }
+
     t0 = profile ? now_sec() : 0.0;
     rope_tail_layer_inplace(scratch->q, DS4_N_HEAD, DS4_N_HEAD_DIM, DS4_N_ROT, pos, il, false);
+    ds4_dump_emit_1d("q_post_rope", scratch->q, DS4_DUMP_DTYPE_F32,
+                     (int64_t)((uint64_t)DS4_N_HEAD * DS4_N_HEAD_DIM));
     rope_tail_layer_inplace(scratch->kv, DS4_N_HEAD_KV, DS4_N_HEAD_DIM, DS4_N_ROT, pos, il, false);
+    ds4_dump_emit_1d("kv_post_rope", scratch->kv, DS4_DUMP_DTYPE_F32,
+                     (int64_t)((uint64_t)DS4_N_HEAD_KV * DS4_N_HEAD_DIM));
     dsv4_fp8_kv_quantize_row_inplace_cpu(scratch->kv, DS4_N_HEAD_DIM, DS4_N_ROT);
 
     kv_cache_push_raw(cache, scratch->kv);
