+/* deepstrix patch: full-vocab logits accessor. */
+int ds4_session_logits_buffer(ds4_session *s, const float **out_ptr, int *out_n) {
+    if (!s || !out_ptr || !out_n) return 0;
+    *out_ptr = s->logits;
+    *out_n = (int)DS4_N_VOCAB;
+    return 1;
+}
