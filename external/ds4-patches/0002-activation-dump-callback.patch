+/* deepstrix patch: activation dump hooks used by Phase 2 kernel ports for
+ * canonical correctness validation. Single-threaded only. The callback fires
+ * at canonical CPU-decode intermediates whenever an evaluation is routed
+ * through forward_token_raw_swa_cpu_decode_scratch (CPU backend +
+ * ds4_session_eval). Tags with `weight:` prefix fire once per layer at
+ * token_pos==0. */
+typedef enum {
+    DS4_DUMP_DTYPE_F32 = 0,
+    DS4_DUMP_DTYPE_F16 = 1,
+    DS4_DUMP_DTYPE_FP8 = 2,
+    DS4_DUMP_DTYPE_I32 = 3,
+} ds4_dump_dtype;
+
+typedef void (*ds4_activation_dump_fn)(void *ud,
+                                       const char *tag,
+                                       const void *data,
+                                       ds4_dump_dtype dtype,
+                                       int ndim,
+                                       const int64_t *shape,
+                                       int layer,
+                                       int token_pos);
+
+void ds4_set_activation_dump(ds4_activation_dump_fn fn, void *ud);
+
