+/* deepstrix patch: activation dump globals + helpers + setter.
+ * Single-threaded; emits only when a callback is registered AND we're inside
+ * the canonical CPU-decode forward path (layer is set non-negative by the
+ * layer-forward prologue and cleared by its epilogue). */
+static ds4_activation_dump_fn g_ds4_dump_fn = NULL;
+static void *g_ds4_dump_ud = NULL;
+static int g_ds4_dump_layer = -1;
+static int g_ds4_dump_pos = -1;
+
+void ds4_set_activation_dump(ds4_activation_dump_fn fn, void *ud) {
+    g_ds4_dump_fn = fn;
+    g_ds4_dump_ud = ud;
+}
+
+static inline void ds4_dump_emit(const char *tag, const void *data,
+                                 ds4_dump_dtype dtype, int ndim,
+                                 const int64_t *shape) {
+    if (!g_ds4_dump_fn || g_ds4_dump_layer < 0) return;
+    g_ds4_dump_fn(g_ds4_dump_ud, tag, data, dtype, ndim, shape,
+                  g_ds4_dump_layer, g_ds4_dump_pos);
+}
+
+static inline void ds4_dump_emit_1d(const char *tag, const void *data,
+                                    ds4_dump_dtype dtype, int64_t n) {
+    const int64_t shape[1] = {n};
+    ds4_dump_emit(tag, data, dtype, 1, shape);
+}
+
+static inline void ds4_dump_emit_2d(const char *tag, const void *data,
+                                    ds4_dump_dtype dtype, int64_t d0, int64_t d1) {
+    const int64_t shape[2] = {d0, d1};
+    ds4_dump_emit(tag, data, dtype, 2, shape);
+}
