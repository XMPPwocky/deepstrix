+/* =========================================================================
+ * deepstrix patch (Track R): IQ3_XXS / IQ2_S / MXFP4 CPU decoding.
+ * =========================================================================
+ *
+ * Scalar ports of llama.cpp's reference implementations
+ * (dequantize_row_iq3_xxs / dequantize_row_iq2_s / dequantize_row_mxfp4 and
+ * ggml_vec_dot_iq3_xxs_q8_K_generic / ggml_vec_dot_iq2_s_q8_K_generic /
+ * ggml_vec_dot_mxfp4_q8_0_generic). Needed to run the unsloth UD-IQ2_XXS
+ * quant mix, whose routed experts are IQ3_XXS (down, most layers),
+ * IQ2_S (gate/up, blk.26) and MXFP4 (down, blk.26/42).
+ *
+ * The MXFP4 dot deviates from llama.cpp in ONE deliberate way: ds4's MoE
+ * pipeline quantizes activations once per token as Q8_K (256-wide blocks,
+ * one f32 scale), not Q8_0, so the dot consumes 8 consecutive MXFP4 blocks
+ * per Q8_K block with the Q8_K scale applied per 32-wide sub-block. The
+ * weight decoding itself (kvalues LUT × E8M0-half scale) is identical.
+ */
+
+/* llama.cpp ggml_e8m0_to_fp32_half: 2^(e-127) / 2, denormal-exact. */
+static inline float ds4_e8m0_to_fp32_half(uint8_t e) {
+    uint32_t bits;
+    if (e < 2) {
+        bits = 0x00200000u << e;
+    } else {
+        bits = (uint32_t)(e - 1) << 23;
+    }
+    float out;
+    memcpy(&out, &bits, sizeof(out));
+    return out;
+}
+
+static DS4_MAYBE_UNUSED void ds4_dequant_row_iq3_xxs(const block_iq3_xxs *x, float *y, int64_t k) {
+    if (k % QK_K != 0) ds4_die("IQ3_XXS dequant length is not QK_K aligned");
+    const int64_t nb = k / QK_K;
+    uint32_t aux32;
+
+    for (int64_t i = 0; i < nb; i++) {
+        const float d = f16_to_f32(x[i].d);
+        const uint8_t *qs = x[i].qs;
+        const uint8_t *scales_and_signs = qs + QK_K / 4;
+
+        for (int ib32 = 0; ib32 < QK_K / 32; ib32++) {
+            memcpy(&aux32, scales_and_signs + 4 * ib32, sizeof(uint32_t));
+            const float db = d * (0.5f + (aux32 >> 28)) * 0.5f;
+            for (int l = 0; l < 4; l++) {
+                const uint8_t signs = ksigns_iq2xs[(aux32 >> (7 * l)) & 127];
+                const uint8_t *grid1 = (const uint8_t *)(iq3xxs_grid + qs[2 * l + 0]);
+                const uint8_t *grid2 = (const uint8_t *)(iq3xxs_grid + qs[2 * l + 1]);
+                for (int j = 0; j < 4; j++) {
+                    y[j + 0] = db * grid1[j] * ((signs & kmask_iq2xs[j + 0]) ? -1.0f : 1.0f);
+                    y[j + 4] = db * grid2[j] * ((signs & kmask_iq2xs[j + 4]) ? -1.0f : 1.0f);
+                }
+                y += 8;
+            }
+            qs += 8;
+        }
+    }
+}
+
+static DS4_MAYBE_UNUSED void ds4_dequant_row_iq2_s(const block_iq2_s *x, float *y, int64_t k) {
+    if (k % QK_K != 0) ds4_die("IQ2_S dequant length is not QK_K aligned");
+    const int64_t nb = k / QK_K;
+    float db[2];
+
+    for (int64_t i = 0; i < nb; i++) {
+        const float d = f16_to_f32(x[i].d);
+        const uint8_t *qs = x[i].qs;
+        const uint8_t *qh = x[i].qh;
+        const uint8_t *signs = qs + QK_K / 8;
+
+        for (int ib32 = 0; ib32 < QK_K / 32; ib32++) {
+            db[0] = d * (0.5f + (x[i].scales[ib32] & 0xf)) * 0.25f;
+            db[1] = d * (0.5f + (x[i].scales[ib32] >> 4)) * 0.25f;
+            for (int l = 0; l < 4; l++) {
+                const float dl = db[l / 2];
+                const uint8_t *grid = (const uint8_t *)(iq2s_grid + (qs[l] | ((qh[ib32] << (8 - 2 * l)) & 0x300)));
+                for (int j = 0; j < 8; j++) {
+                    y[j] = dl * grid[j] * ((signs[l] & kmask_iq2xs[j]) ? -1.0f : 1.0f);
+                }
+                y += 8;
+            }
+            qs += 4;
+            signs += 4;
+        }
+    }
+}
+
+static DS4_MAYBE_UNUSED void ds4_dequant_row_mxfp4(const block_mxfp4 *x, float *y, int64_t k) {
+    if (k % QK_MXFP4 != 0) ds4_die("MXFP4 dequant length is not block aligned");
+    const int64_t nb = k / QK_MXFP4;
+
+    for (int64_t i = 0; i < nb; i++) {
+        const float d = ds4_e8m0_to_fp32_half(x[i].e);
+        for (int j = 0; j < QK_MXFP4 / 2; j++) {
+            const int8_t x0 = kvalues_mxfp4[x[i].qs[j] & 0x0f];
+            const int8_t x1 = kvalues_mxfp4[x[i].qs[j] >> 4];
+            y[i * QK_MXFP4 + j + 0] = x0 * d;
+            y[i * QK_MXFP4 + j + QK_MXFP4 / 2] = x1 * d;
+        }
+    }
+}
+
+static DS4_MAYBE_UNUSED void ds4_vec_dot_iq3_xxs_q8_K(int n, float *s, const block_iq3_xxs *x, const block_q8_K *y) {
+    const int nb = n / QK_K;
+    uint32_t aux32;
+    float sumf = 0.0f;
+
+    for (int i = 0; i < nb; i++) {
+        const float d = f16_to_f32(x[i].d) * y[i].d;
+        const uint8_t *q3 = x[i].qs;
+        const uint8_t *gas = x[i].qs + QK_K / 4;
+        const int8_t *q8 = y[i].qs;
+        int32_t bsum = 0;
+
+        for (int ib32 = 0; ib32 < QK_K / 32; ib32++) {
+            memcpy(&aux32, gas, sizeof(uint32_t));
+            gas += sizeof(uint32_t);
+            const uint32_t ls = 2 * (aux32 >> 28) + 1;
+            int32_t sumi = 0;
+            for (int l = 0; l < 4; l++) {
+                const uint8_t *grid1 = (const uint8_t *)(iq3xxs_grid + q3[2 * l + 0]);
+                const uint8_t *grid2 = (const uint8_t *)(iq3xxs_grid + q3[2 * l + 1]);
+                const uint8_t signs = ksigns_iq2xs[(aux32 >> (7 * l)) & 127];
+                for (int j = 0; j < 4; j++) {
+                    sumi += grid1[j] * q8[j + 0] * ((signs & kmask_iq2xs[j + 0]) ? -1 : 1);
+                    sumi += grid2[j] * q8[j + 4] * ((signs & kmask_iq2xs[j + 4]) ? -1 : 1);
+                }
+                q8 += 8;
+            }
+            q3 += 8;
+            bsum += sumi * (int32_t)ls;
+        }
+        sumf += d * (float)bsum;
+    }
+    *s = 0.25f * sumf;
+}
+
+static DS4_MAYBE_UNUSED void ds4_vec_dot_iq2_s_q8_K(int n, float *s, const block_iq2_s *x, const block_q8_K *y) {
+    const int nb = n / QK_K;
+    float sumf = 0.0f;
+
+    for (int i = 0; i < nb; i++) {
+        const float d = f16_to_f32(x[i].d) * y[i].d;
+        const int8_t *q8 = y[i].qs;
+        const uint8_t *qs = x[i].qs;
+        const uint8_t *qh = x[i].qh;
+        const uint8_t *signs = qs + QK_K / 8;
+        int bsum = 0;
+
+        for (int ib32 = 0; ib32 < QK_K / 32; ib32++) {
+            const int ls1 = 1 + 2 * (x[i].scales[ib32] & 0xf);
+            const int ls2 = 1 + 2 * (x[i].scales[ib32] >> 4);
+            int sumi1 = 0;
+            int sumi2 = 0;
+            for (int l = 0; l < 2; l++) {
+                const uint8_t *grid = (const uint8_t *)(iq2s_grid + (qs[l] | ((qh[ib32] << (8 - 2 * l)) & 0x300)));
+                for (int j = 0; j < 8; j++) {
+                    sumi1 += q8[j] * grid[j] * ((signs[l] & kmask_iq2xs[j]) ? -1 : 1);
+                }
+                q8 += 8;
+            }
+            for (int l = 2; l < 4; l++) {
+                const uint8_t *grid = (const uint8_t *)(iq2s_grid + (qs[l] | ((qh[ib32] << (8 - 2 * l)) & 0x300)));
+                for (int j = 0; j < 8; j++) {
+                    sumi2 += q8[j] * grid[j] * ((signs[l] & kmask_iq2xs[j]) ? -1 : 1);
+                }
+                q8 += 8;
+            }
+            bsum += ls1 * sumi1 + ls2 * sumi2;
+            qs += 4;
+            signs += 4;
+        }
+        sumf += d * (float)bsum;
+    }
+    *s = 0.125f * sumf;
+}
+
+/* Q8_K-activation variant of llama.cpp's mxfp4×q8_0 dot: same integer
+ * LUT math, Q8_K's per-256 f32 scale applied per 32-wide sub-block. */
+static DS4_MAYBE_UNUSED void ds4_vec_dot_mxfp4_q8_K(int n, float *s, const block_mxfp4 *x, const block_q8_K *y) {
+    if (n % QK_K != 0) ds4_die("MXFP4 dot length is not QK_K aligned");
+    const int nb = n / QK_K;
+    float sumf = 0.0f;
+
+    for (int i = 0; i < nb; i++) {
+        const int8_t *q8 = y[i].qs;
+        for (int j = 0; j < QK_K / QK_MXFP4; j++) {
+            const block_mxfp4 *xb = &x[i * (QK_K / QK_MXFP4) + j];
+            const float d = y[i].d * ds4_e8m0_to_fp32_half(xb->e);
+            int sumi1 = 0;
+            int sumi2 = 0;
+            for (int l = 0; l < QK_MXFP4 / 2; l++) {
+                sumi1 += q8[l] * kvalues_mxfp4[xb->qs[l] & 0x0f];
+                sumi2 += q8[l + QK_MXFP4 / 2] * kvalues_mxfp4[xb->qs[l] >> 4];
+            }
+            sumf += d * (float)(sumi1 + sumi2);
+            q8 += QK_MXFP4;
+        }
+    }
+    *s = sumf;
+}
+
+/* Public reference API for the ds4-dump quant self-test (quants_selftest.c):
+ * raw-byte prototypes so the test can construct blocks without the private
+ * struct definitions. */
+void ds4_ref_quantize_row_q8_K(const float *x, void *y, int64_t n) {
+    ds4_quantize_row_q8_K(x, (block_q8_K *)y, n);
+}
+
+size_t ds4_ref_q8_K_row_bytes(int64_t n) {
+    return (size_t)(n / QK_K) * sizeof(block_q8_K);
+}
+
+int ds4_ref_dequant_row(uint32_t gguf_type, const void *src, float *dst, int64_t n) {
+    switch (gguf_type) {
+    case 18: ds4_dequant_row_iq3_xxs((const block_iq3_xxs *)src, dst, n); return 0;
+    case 22: ds4_dequant_row_iq2_s((const block_iq2_s *)src, dst, n); return 0;
+    case 39: ds4_dequant_row_mxfp4((const block_mxfp4 *)src, dst, n); return 0;
+    default: return -1;
+    }
+}
+
+int ds4_ref_vec_dot_q8k(uint32_t gguf_type, int n, float *s, const void *x, const void *y_q8k) {
+    const block_q8_K *y = (const block_q8_K *)y_q8k;
+    switch (gguf_type) {
+    case 18: ds4_vec_dot_iq3_xxs_q8_K(n, s, (const block_iq3_xxs *)x, y); return 0;
+    case 22: ds4_vec_dot_iq2_s_q8_K(n, s, (const block_iq2_s *)x, y); return 0;
+    case 39: ds4_vec_dot_mxfp4_q8_K(n, s, (const block_mxfp4 *)x, y); return 0;
+    default: return -1;
+    }
+}
